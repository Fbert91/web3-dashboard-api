# Web3 Dashboard API - Configuration Template
# Copy this file to .env and fill in your actual values

# ==============================================================================
# Ethereum RPC Provider Configuration
# ==============================================================================
# Get free RPC URL from:
# - Infura: https://infura.io/
# - Alchemy: https://www.alchemy.com/
# - Ankr: https://www.ankr.com/

# SEPOLIA TESTNET (Recommended for learning)
Web3__RpcUrl=https://sepolia.infura.io/v3/YOUR_INFURA_PROJECT_ID
Web3__NetworkId=11155111
Web3__ChainName=Sepolia Testnet

# ==============================================================================
# Optional: Ethereum Explorer API (for advanced features)
# ==============================================================================
Web3__EtherscanApiUrl=https://sepolia.etherscan.io/api

# ==============================================================================
# Optional: Smart Contract Addresses
# ==============================================================================
# Add your deployed contract addresses here

# Example: Your deployed SimpleToken
# Web3__SimpleTokenAddress=0x1234567890abcdef...

# Example: Known testnet tokens
# Web3__USDCAddress=0x7af173f350d916b7e4553b2b5e2b9150bffb7d42
# Web3__WETHAddress=0x7b79995e5f793A07Bc00c21412e50Ecae098E7f9

# ==============================================================================
# Application Settings
# ==============================================================================
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5000;https://localhost:5001

# ==============================================================================
# Database Configuration (SQLite)
# ==============================================================================
# File path for SQLite database (default: current directory)
Database__Path=./web3dashboard.db

# ==============================================================================
# Logging
# ==============================================================================
# Log level: Debug, Information, Warning, Error, Critical
LogLevel=Information

# ==============================================================================
# Security (For future use)
# ==============================================================================
# API Keys for authentication (when implemented)
# API_KEY=your_secure_key_here

# ==============================================================================
# Notes:
# ==============================================================================
# 1. NEVER commit .env file to git (it's in .gitignore)
# 2. Keep YOUR_INFURA_PROJECT_ID private
# 3. For mainnet, use RPC_URL_MAINNET endpoint
# 4. Test on Sepolia before deploying to mainnet
# 5. Get free test ETH from: https://www.sepoliafaucet.com/
