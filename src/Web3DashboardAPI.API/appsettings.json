{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=Web3Dashboard.db"
  },
  "Ethereum": {
    "RpcUrl": "https://sepolia.infura.io/v3/YOUR_INFURA_KEY",
