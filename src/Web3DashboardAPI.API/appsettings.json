  },
  "RateLimiting": {
    "Enabled": true,
    "RequestsPerWindow": 100,
    "WindowDurationSeconds": 60
  },
  "ApiKeys": {
    "Valid": {
      "test-key-12345": "test-user",
      "your-api-key-here": "your-user-id"
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "https://yourdomain.com",
      "https://app.yourdomain.com"
    ]
  }
}

